# Single place where "what blocks a build" is defined.
#
# Every stage reads these values instead of hard-coding thresholds, so raising
# or lowering the bar is one reviewed diff rather than a hunt through scripts.
# Values are deliberately boring shell assignments: the file is sourced by the
# stage scripts and parsed by CI without a YAML dependency.

# Severities that stop the pipeline. Note that MEDIUM is absent on purpose and
# the reasoning is in the README: gating on CRITICAL only is worse than useless,
# gating on MEDIUM on day one buries the team.
FAIL_ON_SEVERITY="HIGH,CRITICAL"

# Findings with no released fix cannot be acted on by the team that owns the
# service. They are reported every run and reviewed on a schedule, but they do
# not block a deploy that the developer has no way to unblock.
IGNORE_UNFIXED="true"

# Secret scanning has no severity dimension: one leaked credential is enough.
SECRETS_FAIL_ON_ANY="true"

# Dockerfile and manifest policy. Conftest warnings are informational, denials
# stop the build.
POLICY_FAIL_ON_WARN="false"

# Signature verification is mandatory before an image may be considered
# releasable, including in the local demo.
REQUIRE_SIGNATURE="true"
